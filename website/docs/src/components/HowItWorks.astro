---
// HowItWorks — 01 Define → 02 Apply → 03 Synced.
// Numbers earned: the sequence IS the information. Transcript lines are
// verbatim CLI output markers (✔ Linked, ✔ OK, Status: All good).
const isSpanish = Astro.locals.starlightRoute.locale === "es";
---

<section class="how-section" aria-labelledby="how-heading">
	<h2 id="how-heading" class="how-heading">
		{isSpanish ? "Cómo funciona AgentSync" : "How AgentSync works"}
	</h2>
	<ol class="how-grid" role="list">
		<li class="how-step">
			<span class="how-num" aria-hidden="true">01</span>
			<h3 class="how-title">{isSpanish ? "Definir" : "Define"}</h3>
			<p class="how-desc">
				{isSpanish
					? "Guarda las instrucciones, las skills y la configuración MCP en .agents/ como fuente única de verdad."
					: "Keep instructions, skills, and MCP configuration in .agents/ — the single source of truth."}
			</p>
			<pre class="how-snippet"><code>.agents/AGENTS.md</code></pre>
		</li>
		<li class="how-step">
			<span class="how-num" aria-hidden="true">02</span>
			<h3 class="how-title">Apply</h3>
			<p class="how-desc">
				{isSpanish
					? "Ejecuta un comando. AgentSync crea symlinks nativos: sin copias ni diferencias entre asistentes."
					: "Run one command. AgentSync materializes native symlinks — no copies, no drift."}
			</p>
			<pre class="how-snippet"><code>$ agentsync apply
✔ Linked: CLAUDE.md -&gt; .agents/AGENTS.md</code></pre>
		</li>
		<li class="how-step">
			<span class="how-num" aria-hidden="true">03</span>
			<h3 class="how-title">{isSpanish ? "Sincronizado" : "Synced"}</h3>
			<p class="how-desc">
				{isSpanish
					? "Todos los asistentes acceden a los mismos archivos. Comprueba el estado cuando quieras."
					: "Every assistant reads the same files. Verify the state anytime."}
			</p>
			<pre class="how-snippet"><code>✔ OK: CLAUDE.md -&gt; .agents/AGENTS.md
Status: All good</code></pre>
		</li>
	</ol>
</section>

<style>
	.how-section {
		max-width: 1100px;
		margin: var(--as-space-3xl, 64px) auto;
		padding: 0 var(--as-space-lg, 24px);
	}

	.how-heading {
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 700;
		text-align: center;
		margin: 0 0 var(--as-space-xl, 32px) 0;
		color: var(--as-text-primary, #fff);
	}

	.how-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--as-space-lg, 24px);
		list-style: none;
		margin: 0;
		padding: 0;
		counter-reset: how;
	}

	.how-step {
		display: flex;
		flex-direction: column;
		gap: var(--as-space-sm, 8px);
		min-width: 0;
		padding: var(--as-space-lg, 24px);
		background: var(--as-bg-card, rgba(18, 18, 24, 0.6));
		border: 1px solid var(--as-border, rgba(255, 255, 255, 0.08));
		border-radius: var(--as-radius-md, 10px);
	}

	.how-num {
		color: var(--as-accent, #a78bfa);
		font-family: var(--sl-font-mono);
		font-size: 0.875rem;
	}

	.how-title {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 650;
		color: var(--as-text-primary, #fff);
	}

	.how-desc {
		margin: 0;
		color: var(--as-text-muted, #9ca3af);
		line-height: 1.6;
	}

	.how-snippet {
		margin: auto 0 0;
		padding: 0.75rem;
		border-radius: var(--as-radius-sm, 6px);
		background: rgba(0, 0, 0, 0.3);
		color: var(--as-text-secondary, #d1d5db);
		font-size: 0.8125rem;
		overflow-x: auto;
	}

	@media (max-width: 760px) {
		.how-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
