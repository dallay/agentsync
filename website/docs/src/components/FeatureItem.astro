---
// FeatureItem - Individual feature card with glassmorphism and hover effects
import { withBase } from "../utils/links";

interface Props {
	title: string;
	description: string;
	icon?: string;
	href?: string;
	variant?: "lead" | "compact";
}

const { title, description, icon = "✨", href, variant = "lead" } = Astro.props;
const resolvedHref = typeof href === "string" ? withBase(href) : href;
const Tag = resolvedHref ? "a" : "div";
const variantClass = variant === "compact" ? "is-compact" : "is-lead";
---

<Tag class:list={["feature-item", variantClass]} href={resolvedHref || undefined}>
    <span class="feature-icon" aria-hidden="true"><slot name="icon">{icon}</slot></span>
    <h3 class="feature-title">{title}</h3>
    <p class="feature-desc">{description}</p>
</Tag>

<style>
    .feature-item {
        display: flex;
        flex-direction: column;
        padding: var(--as-space-lg, 24px);
        background: var(--as-bg-card, rgba(18, 18, 24, 0.6));
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--as-border, rgba(255, 255, 255, 0.08));
        border-radius: var(--as-radius-lg, 16px);
        text-decoration: none;
        color: inherit;
        transition:
            transform var(--as-transition-base, 250ms ease),
            border-color var(--as-transition-base, 250ms ease),
            box-shadow var(--as-transition-base, 250ms ease);
    }

    .feature-item:hover {
        transform: translateY(-4px);
        border-color: var(--as-border-hover, rgba(255, 255, 255, 0.15));
        box-shadow: var(--as-shadow-md, 0 12px 32px rgba(0, 0, 0, 0.3));
    }

    a.feature-item:hover {
        cursor: pointer;
    }

    .feature-icon {
        font-size: 2rem;
        margin-bottom: var(--as-space-sm, 8px);
        display: block;
        line-height: 1;
        color: var(--as-text-secondary, #9aa7b3);
    }

    .feature-icon :global(svg) {
        width: 2rem;
        height: 2rem;
        display: block;
    }

    .is-compact {
        padding: var(--as-space-md, 16px);
    }

    .is-compact .feature-icon {
        font-size: 1.25rem;
    }

    .is-compact .feature-icon :global(svg) {
        width: 1.25rem;
        height: 1.25rem;
    }

    .is-compact .feature-title {
        font-size: 1rem;
    }

    .feature-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0 0 var(--as-space-sm, 8px) 0;
        color: var(--as-text-primary, #fff);
    }

    .feature-desc {
        font-size: 0.9rem;
        color: var(--as-text-secondary, #9aa7b3);
        margin: 0;
        line-height: 1.5;
    }
</style>
