---
import { withBase, withLocale } from "../utils/links";

const { href, ...rest } = Astro.props;
const locale = Astro.locals.starlightRoute.locale;
const localizedHref = typeof href === "string" ? withLocale(href, locale) : href;
const resolvedHref = typeof localizedHref === "string" ? withBase(localizedHref) : localizedHref;
---

<a href={resolvedHref} {...rest}>
	<slot />
</a>
